# Single source of configuration for the Docker Compose stack.
# Copy this file to .env and fill in every empty value before running `docker compose up`.
# .env is ignored by git: never commit real credentials.

# Host ports
APP_PORT=8080
DB_FORWARD_PORT=5432

# User and group that run PHP inside the api container (`id -u` and `id -g`)
APP_UID=1000
APP_GID=1000

# Laravel
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
# Required. Generate it with: echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# PostgreSQL, shared by the postgres and api containers
DB_DATABASE=
DB_USERNAME=
# Required. Choose your own password.
DB_PASSWORD=

